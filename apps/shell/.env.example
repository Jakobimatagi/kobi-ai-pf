# Override the deployed remote URLs (optional — sensible defaults are baked in).
# In dev these default to localhost; in production to the deployed Vercel URLs.

# React weather remote — Module Federation remoteEntry.js URL (build-time).
VITE_WEATHER_REMOTE_URL=https://kobi-ai-pf-weather.vercel.app/remoteEntry.js

# Angular Wordle remote — iframe origin (runtime).
VITE_WORDLE_URL=https://kobi-ai-pf-wordle.vercel.app
