# Override the deployed remote URLs (optional — sensible defaults are baked in).
# In dev these default to localhost; in production to the deployed Vercel URLs.

# React MFE — Module Federation remoteEntry.js URL (build-time).
VITE_REACT_REMOTE_URL=https://kobi-ai-pf-react.vercel.app/remoteEntry.js

# Angular MFE — iframe origin (runtime).
VITE_ANGULAR_URL=https://kobi-ai-pf-angular.vercel.app
